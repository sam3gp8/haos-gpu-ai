# =============================================================================
# NVIDIA + AMD kernel fragment  (profile: nvidia-amd)
# Identical to kernel/gpu-ai.config EXCEPT the Intel Xe driver is omitted.
# Xe (CONFIG_DRM_XE) is the single most kernel-version-fragile symbol here - it
# does not exist before ~6.8 and its Kconfig moves around - so the first-green
# target leaves it out. i915 is retained (in-tree, harmless, autoloads only on
# Intel hardware) so nothing else changes. Switch to profile 'all' to add Xe.
# =============================================================================

# --- Loadable module support (required for out-of-tree NVIDIA modules) --------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_MODVERSIONS=y

# --- Direct Rendering Manager core -------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_TTM=m
CONFIG_DRM_SCHED=m
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- Intel GPU (i915 only; Xe deliberately omitted for this profile) ---------
CONFIG_DRM_I915=m
CONFIG_DRM_I915_GVT=y

# --- AMD GPU + KFD compute (ROCm/HIP kernel side) -----------------------------
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMD_DC=y
CONFIG_HSA_AMD=y
CONFIG_HSA_AMD_SVM=y
CONFIG_HSA_AMD_P2P=y

# --- Heterogeneous / Unified Memory -------------------------------------------
CONFIG_ZONE_DEVICE=y
CONFIG_HMM_MIRROR=y
CONFIG_DEVICE_PRIVATE=y
CONFIG_MMU_NOTIFIER=y
CONFIG_TRANSPARENT_HUGEPAGE=y

# --- Nouveau (module, blacklisted at runtime so proprietary can bind) ---------
CONFIG_DRM_NOUVEAU=m

# --- PCI / IOMMU (large-VRAM BAR + DMA on discrete cards) ---------------------
CONFIG_PCI=y
CONFIG_PCIEASPM=y
CONFIG_PCI_REALLOC_ENABLE_AUTO=y
CONFIG_DMADEVICES=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
CONFIG_IOMMU_DEFAULT_PASSTHROUGH=y
