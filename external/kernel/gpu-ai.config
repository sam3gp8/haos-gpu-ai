# =============================================================================
# Unified GPU/AI kernel configuration fragment
# Appended to the upstream HAOS kernel fragments by merge-defconfig.sh via
# BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES. Fragments are applied with
# scripts/kconfig/merge_config.sh, so these settings override/extend whatever
# the base HAOS kernel config already provides.
# =============================================================================

# --- Loadable module support (required for out-of-tree NVIDIA modules) --------
# NOTE: out-of-tree modules need CONFIG_MODULES + the configured kernel build
# tree. They do NOT need CONFIG_STAGING (that only enables the in-tree
# drivers/staging subsystem and is unrelated to external module builds).
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
# Allow loading the unsigned, GPL-incompatible NVIDIA modules (tolerate taint).
# If the base config force-enables module signing enforcement, relax it here.
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_MODVERSIONS=y

# --- Direct Rendering Manager core -------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_TTM=m
CONFIG_DRM_SCHED=m
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- Intel GPU / XPU ----------------------------------------------------------
CONFIG_DRM_I915=m
CONFIG_DRM_I915_GVT=y
# Xe is the modern Intel compute/display driver. It is still gated behind
# EXPERT/experimental on some kernels; if the build errors that DRM_XE is
# unknown for the pinned kernel, drop this line - i915 still exposes /dev/dri.
CONFIG_DRM_XE=m
CONFIG_DRM_XE_DISPLAY=y

# --- AMD GPU + KFD compute (ROCm/HIP kernel side) -----------------------------
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMD_DC=y
# HSA / KFD is the compute interface ROCm talks to (creates /dev/kfd).
CONFIG_HSA_AMD=y
CONFIG_HSA_AMD_SVM=y
CONFIG_HSA_AMD_P2P=y

# --- Heterogeneous / Unified Memory -------------------------------------------
# These are the ACTUAL kernel dependencies for "unified memory" / shared virtual
# addressing used by amdgpu SVM and NVIDIA UVM's HMM paths - not CONFIG_STAGING.
CONFIG_ZONE_DEVICE=y
CONFIG_HMM_MIRROR=y
CONFIG_DEVICE_PRIVATE=y
CONFIG_MMU_NOTIFIER=y
CONFIG_TRANSPARENT_HUGEPAGE=y

# --- Nouveau ------------------------------------------------------------------
# Keep nouveau as a module so the image still boots on NVIDIA hardware even if
# the proprietary stack is unavailable, but it is blacklisted at runtime (see
# rootfs-overlay/etc/modprobe.d/gpu-ai.conf) so the proprietary driver can bind.
CONFIG_DRM_NOUVEAU=m

# --- PCI / IOMMU (needed for large-VRAM BAR + DMA on discrete cards) ----------
CONFIG_PCI=y
CONFIG_PCIEASPM=y
# Resizable BAR support - important for large-context LLM VRAM mapping.
CONFIG_PCI_REALLOC_ENABLE_AUTO=y
CONFIG_DMADEVICES=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
CONFIG_IOMMU_DEFAULT_PASSTHROUGH=y
